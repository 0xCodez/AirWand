# Normalize line endings: LF in the repo and in working trees by default.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly in PowerShell / cmd.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Shell scripts are always LF (also on Windows checkouts).
*.sh   text eol=lf

# Binary assets: never diff, never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.icns  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.apk   binary
*.aab   binary
*.ipa   binary
*.jar   binary

# Lockfiles: keep them out of diff noise in PRs.
Cargo.lock    linguist-generated=true
pubspec.lock  linguist-generated=true

# The UI prototype is docs, not the project's main language.
docs/prototype/** linguist-documentation
